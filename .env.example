# Environment variables (copy to `.env` — never commit `.env`)

# Google Gemini (required for RAG embeddings; also used when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Chat provider: gemini (default) or openrouter
LLM_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/settings/keys) — MiniMax free model
OPENROUTER_API_KEY=sk-or-v1-your_key_here
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_MAX_TOKENS=2048

# Supabase (required — https://supabase.com/dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
